{
  "name": "analyzer-pro",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "PUBLIC_APP_URL": "https://analyzer-pro.fx77.workers.dev"
  },
  "triggers": {
    "crons": [
      "26 7 * * *",
      "31 7 * * *",
      "26 12 * * *",
      "31 12 * * *"
    ]
  }
}
