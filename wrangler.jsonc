{
  "name": "analyzer-pro",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    { "binding": "CTRADER_KV", "id": "689d14af017b4f4fbf10a72b00af49bd" }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-3.1-flash-lite"
  }
}
